local shop_section = misc_tab:section({name = "shop", side = "right"})

shop_section:dropdown({
    name = "select gun", 
    flag = "selected_shop_gun", 
    items = {"double-barrel sg", "revolver", "rifle", "shotgun", "tacticalshotgun", "flintlock", "ak47", "p90", "lmg", "aug"}, 
    default = "revolver"
})

shop_section:button({name = "buy gun", callback = function()
    local item = type(flags.selected_shop_gun) == "table" and flags.selected_shop_gun[1] or flags.selected_shop_gun or "revolver"
    buy_item(item, 1)
end})

shop_section:slider({name = "ammo amount", flag = "shop_ammo_amount", min = 1, max = 50, default = 5, suffix = "x"})

shop_section:button({name = "buy ammo for gun", callback = function()
    local item = type(flags.selected_shop_gun) == "table" and flags.selected_shop_gun[1] or flags.selected_shop_gun or "revolver"
    local amt = flags.shop_ammo_amount or 5
    buy_item(item .. " ammo", amt)
end})

shop_section:dropdown({
    name = "select utility", 
