local function is_target_valid(data)
    if not data or data[7] or data[18] or not data[3] then return false end
    local parts = data[4]
    if not parts or not parts.HumanoidRootPart then return false end
    local hrp_pos = parts.HumanoidRootPart.Position
    if hrp_pos.Magnitude > 9e8 then return false end
    local is_rifle = local_tool and (local_tool.Name == "[Rifle]" or local_tool.Name == "[Flintlock]")
    if not is_rifle and (parts.FORCEFIELD or parts.ForceField or parts.GRABBING_CONSTRAINT) then return false end
    return true
end

local function get_closest_to_mouse()
    local mouse_pos = get_mouse_pos()
    local closest = 9e9
    local best = nil
    for plr, data in pairs(player_data) do
        if is_target_valid(data) then
            local hrp_pos = data[4].HumanoidRootPart.Position
            local pos, on_screen = w2v(hrp_pos)
            if not on_screen and not flags.view_target then continue end
            local dist_studs = (local_client_position.p - hrp_pos).Magnitude
            if flags.target_selection_target_distance and flags.target_selection_target_distance ~= 250 and dist_studs > flags.target_selection_target_distance then continue end
            local dist = (v2(pos.X, pos.Y) - mouse_pos).Magnitude
            local fov = flags.ragebot_field_of_view
            if fov and fov ~= 180 and not flags.view_target then
                local max_dist = (camera.ViewportSize.Magnitude / (pi/2)) * (fov/180)
                if dist > max_dist then continue end
            end
            if dist < closest then
                closest = dist
                best = data
            end
        end
    end
    return best
end

local function get_closest_to_char()
    local closest = math.huge
    local best = nil
    for plr, data in pairs(player_data) do
        if is_target_valid(data) then
            local dist = (local_client_position.p - data[4].HumanoidRootPart.Position).Magnitude
            if flags.target_selection_target_distance and flags.target_selection_target_distance ~= 250 and dist > flags.target_selection_target_distance then continue end
            if dist < closest then closest = dist best = data end
        end
    end
    return best
end

local function get_lowest_hp()
    local lowest = math.huge
    local best = nil
    for plr, data in pairs(player_data) do
        if is_target_valid(data) then
            if data[9] < lowest then lowest = data[9] best = data end
        end
    end
    return best
end

local function get_random_target()
    local targets = {}
    for plr, data in pairs(player_data) do
        if is_target_valid(data) then
            table.insert(targets, data)
        end
    end
    if #targets > 0 then return targets[random(#targets)] end
    return nil
end

local function get_ragebot_target_func()
    local mode = type(flags.prioritize_by) == "table" and flags.prioritize_by[1] or flags.prioritize_by or "closest to mouse"
    if mode == "closest to character" then return get_closest_to_char() end
    if mode == "lowest health" then return get_lowest_hp() end
    if mode == "random" then return get_random_target() end
    return get_closest_to_mouse()
end

local function do_ragebot(dt, hrp)
    if not flags.ragebot then
        ragebot_aim_position = nil
        return
    end

    local target = ragebot_target
    local tick = clock()

    if target then
        if not is_target_valid(target) then
            set_ragebot_target(nil, "target lost")
            target = nil
        elseif flags.target_selection_untarget_when and table.find(flags.target_selection_untarget_when, "better target") then
            local best = get_ragebot_target_func()
            if best and best ~= target then
                set_ragebot_target(best, "switched to better target")
                target = ragebot_target
            end
        end
    end

    if not target and (flags.target_selection_automatic or not flags.target_selection_target_bind) then
        local best = get_ragebot_target_func()
        if best then
            set_ragebot_target(best, "target set to " .. best[2].Name)
            target = ragebot_target
        end
    end

    if not target or not target[4] then
        ragebot_aim_position = nil
        target_last_position = nil
        target_velocity = v3()
        return
    end

    local hitbox = get_target_hitbox(target, flags.ragebot_hitbox)
    local torso = target[4].HumanoidRootPart or target[4].Torso or hitbox
    if not hitbox or not torso then ragebot_aim_position = nil return end

    if tick - last_refresh > (flags.resolver_rate or 0.037) then
        local torso_pos = torso.Position
        if target_last_position then
            target_velocity = (torso_pos - target_last_position) / (tick - last_refresh)
        end
        target_last_position = torso_pos
        last_refresh = tick
    end

    local hitbox_pos = hitbox.Position
    ragebot_aim_position = hitbox_pos

    if target_velocity then
        local pred = flags.prediction or 0
        if pred == 0 then pred = local_ping / 500 elseif pred == 2000 then pred = 0 else pred = pred / 1000 end
        ragebot_aim_position = ragebot_aim_position + (target_velocity * pred)
    end

    if flags.auto_fire_at_backtrack then
        local bt = backtrack_data[target[2]]
        if bt and bt[2] then
            local bt_hitbox = get_target_hitbox({[4]=bt[2]}, flags.ragebot_hitbox)
            if bt_hitbox then ragebot_aim_position = bt_hitbox.Position end
        end
    end

    is_defensive = false
    if flags.auto_fire_defensive then
        local def_pos = {}
        local weight = hitbox_pos.Magnitude < 9e5 and (flags.void_spam_resolver_position_weight or 1.5) or (flags.void_spam_resolver_void_weight or 0.2)
        if not def_pos[hitbox_pos] then def_pos[hitbox_pos] = {w = weight, t = tick} end
        local highest = nil
        local highest_w = 0
        for pos, d in pairs(def_pos) do
            if d.w > highest_w then highest_w = d.w highest = pos end
        end
        local acc = flags.void_spam_resolver_accuracy or 76.82
        acc = 1 + (0.6525 * ((-50 + acc) / 50))
        if highest and highest_w > acc then
            ragebot_aim_position = highest
            target_velocity = v3()
            target_last_position = highest
            is_defensive = true
        end
    end

    ragebot_aim_position = ragebot_force_position or ragebot_aim_position
    if custom_ragebot_aim_position then
        ragebot_aim_position = custom_ragebot_aim_position
        custom_ragebot_aim_position = nil
    end

    if local_gun and flags.auto_fire then
        local cooldown = (flags.fire_cooldown or 5) / 1000
        if tick - last_fire > cooldown then
            if flags.auto_fire_always_fire or (local_server_position.p - ragebot_aim_position).Magnitude <= local_gun then
                local new_guns = {}
                for handle, gun_data in pairs(local_guns) do
                    local parent = handle.Parent
                    if parent and (parent.Name == "[Rifle]" or parent.Name == "[Flintlock]") then
                        table.insert(new_guns, gun_data)
                    end
                end
                for handle, gun_data in pairs(local_guns) do
                    local parent = handle.Parent
                    if parent and parent.Name ~= "[Rifle]" then table.insert(new_guns, gun_data) end
                end
                for i = 1, #new_guns do
                    local gd = new_guns[i]
                    local handle = gd[1]
                    local ammo = gd[3]
                    if ammo > 0 and handle.Parent then
                        last_fire = clock()
                        local delay_ms = flags.shot_delay or 0
                        if delay_ms > 0 then task.wait(delay_ms / 1000) end
                        local origin = local_server_position.p
                        local pos = ragebot_aim_position
                        local dir = (pos - origin)
                        local mag = dir.Magnitude
                        event:FireServer("ShootGun", handle, origin, pos, hitbox, (mag <= 0 or mag ~= mag) and (handle.Position - pos).Unit or dir.Unit)
                    end
                end
            end
        end
    end
end

local function do_follow_target(dt, hrp)
    if not flags.follow_target or not ragebot_target or not hrp or not ragebot_aim_position or ragebot_target[7] then
        local_following = false
        return
    end
    if flags.follow_target_stop_if then
        if table.find(flags.follow_target_stop_if, "reloading") and local_reloading then local_following = false return end
        if table.find(flags.follow_target_stop_if, "target knocked") and ragebot_target[18] then local_following = false return end
        if table.find(flags.follow_target_stop_if, "no gun equipped") and not local_gun then local_following = false return end
    end
    local old_cframe = hrp.CFrame
    local dist = flags.follow_target_distance or 15
    local style = type(flags.follow_target_dropdown) == "table" and flags.follow_target_dropdown[1] or flags.follow_target_dropdown or "random"
    local new_cf
    if style == "random" or style == "random spam" then
        new_cf = cfr(ragebot_aim_position + v3(random(-dist, dist), random(-dist, dist), random(-dist, dist)))
        new_cf = new_cf * cfa(rad(random(1,359)), rad(random(1,359)), rad(random(1,359)))
    elseif style == "strafe" then
        local speed = flags.follow_target_speed or 75
        local height = flags.follow_target_height or 0
        new_cf = cfa(0, rad(360 * ((clock() * speed / 50) % 1)), 0) * cfr(0, 0, dist) + (ragebot_aim_position + v3(0, height, 0))
    else
        new_cf = cfr(ragebot_aim_position + v3(random(-dist, dist), random(-dist, dist), random(-dist, dist)))
    end
    local_following = true
    hrp.CFrame = new_cf
    run.RenderStepped:Wait()
    hrp.CFrame = old_cframe
end

local function do_void_hide(dt, hrp)
    if not flags.void_hide or not hrp then in_void = false return end
    if flags.void_hide_disable_when then
        if table.find(flags.void_hide_disable_when, "target selected") and ragebot_target then return end
        if table.find(flags.void_hide_disable_when, "following target") and local_following then return end
        if table.find(flags.void_hide_disable_when, "target knocked") and ragebot_target and ragebot_target[18] then return end
        if table.find(flags.void_hide_disable_when, "purchasing") and purchasing then return end
    end
    local forced = false
    if flags.void_hide_force_when then
        if table.find(flags.void_hide_force_when, "reloading") and local_reloading then forced = true end
        if table.find(flags.void_hide_force_when, "not full health") then
            local hum = local_parts.Humanoid
            if hum and hum.Health < hum.MaxHealth then forced = true end
        end
        if table.find(flags.void_hide_force_when, "tabbed out") and isrbxactive and not isrbxactive() then forced = true end
    end
    local old_cf = hrp.CFrame
    local old_vel = hrp.Velocity
    in_void = true
    local vtype = type(flags.void_hide_type) == "table" and flags.void_hide_type[1] or flags.void_hide_type or "random"
    local offset = flags.void_hide_offset or 0
    if vtype == "random" or vtype == "vc server" then
        if vtype == "vc server" then
            hrp.CFrame = cfr(v3(0, random(-2147483647, 2147483647), 0)) + v3(random(-offset, offset), random(-offset, offset), random(-offset, offset))
        else
            hrp.CFrame = cfr(v3(random(-2147483647, 2147483647), random(-400, 2147483647), random(-2147483647, 2147483647))) + v3(random(-offset, offset), random(-offset, offset), random(-offset, offset))
        end
        hrp.CFrame = hrp.CFrame * cfa(rad(random(1,359)), rad(random(1,359)), rad(random(1,359)))
    elseif vtype == "bait" then
        local bait_dist = flags.void_hide_bait_distance or 250
        hrp.CFrame = cfr(v3(random(-bait_dist, bait_dist), random(-200, 200), random(-bait_dist, bait_dist)))
    end
    run.RenderStepped:Wait()
    hrp.CFrame = old_cf
    hrp.Velocity = old_vel
end

local function do_velocity_desync(dt, hrp)
    if not flags.velocity_desync or not hrp or stomping or purchasing then return end
    if flags.velocity_desync_disable_when then
        if table.find(flags.velocity_desync_disable_when, "auto stomping") and stomping then return end
        if table.find(flags.velocity_desync_disable_when, "above x health") then
            local hum = local_parts.Humanoid
            local threshold = (flags.velocity_desync_health or 0) / 100
            if hum and hum.Health / hum.MaxHealth >= threshold then return end
        end
    end
    local old_lin = hrp.AssemblyLinearVelocity
    local old_ang = hrp.AssemblyAngularVelocity
    local vtype = type(flags.velocity_desync_type) == "table" and flags.velocity_desync_type[1] or flags.velocity_desync_type or "high"
    local vel
    if vtype == "high y" then vel = v3(0, 16384, 0)
    elseif vtype == "limit" then vel = v3(random(-9223372036854775808, 9223372036854775807), random(-9223372036854775808, 9223372036854775807), random(-9223372036854775808, 9223372036854775807))
    elseif vtype == "low" then vel = v3(random(1,2) == 1 and -300 or 300, random(1,2) == 1 and -300 or 300, random(1,2) == 1 and -300 or 300)
    elseif vtype == "high" then vel = v3(random(1,2) == 1 and -16384 or 16384, random(1,2) == 1 and -14384 or 16384, random(1,2) == 1 and -16384 or 16384)
    elseif vtype == "zero" then vel = v3()
    else vel = v3() end
    hrp.AssemblyLinearVelocity = vel
    if flags.velocity_desync_rotate then hrp.AssemblyAngularVelocity = vel end
    run.RenderStepped:Wait()
    hrp.AssemblyLinearVelocity = old_lin
    hrp.AssemblyAngularVelocity = old_ang
end

local function do_speed(dt, hrp)
    if not flags.speed or not hrp then return end
    local humanoid = local_parts.Humanoid
    if not humanoid then return end
    local move_dir = humanoid.MoveDirection
    local mult = (flags.speed_value or 35) * 16
    local style = type(flags.speed_style) == "table" and flags.speed_style[1] or flags.speed_style or "normal"
    if style == "normal" then
        hrp.CFrame = hrp.CFrame + (v3(move_dir.X, 0, move_dir.Z) * dt * mult)
    elseif style == "bhop" then
        hrp.CFrame = hrp.CFrame + (v3(move_dir.X, 0, move_dir.Z) * dt * mult)
        if humanoid:GetState() == Enum.HumanoidStateType.Running then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
    elseif style == "minecraft" then
        hrp.CFrame = hrp.CFrame + (v3(move_dir.X, 0, move_dir.Z) * dt * mult)
        if humanoid:GetState() == Enum.HumanoidStateType.Running then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            hrp.Velocity = hrp.Velocity * v3(1, 1.5, 1)
            task.wait(humanoid.JumpPower / 500)
            hrp.Velocity = hrp.Velocity * v3(1, -1.1, 1)
        end
    end
end

local function do_flight(dt, hrp)
    if not flags.flight or not hrp then return end
    local humanoid = local_parts.Humanoid
    if not humanoid then return end
    local move_dir = humanoid.MoveDirection
    local mult = (flags.flight_value or 35) * 50
    local y = 0
    if uis:IsKeyDown(Enum.KeyCode.Space) then y = 1
    elseif uis:IsKeyDown(Enum.KeyCode.S) then y = -camera.CFrame.lookVector.Y
    elseif uis:IsKeyDown(Enum.KeyCode.W) then y = camera.CFrame.lookVector.Y end
    hrp.Velocity = v3(0, pi - 2, 0)
    hrp.CFrame = hrp.CFrame + (v3(move_dir.X, y * clamp(move_dir.Magnitude, 0, 1), move_dir.Z) * dt * mult)
end

