local function draw_3d_circle(cf, radius, color)
    local points = {}
    for i = 1, circle_segments do
        local angle = rad((i - 1) * (360 / circle_segments))
        local world_pt = cf:PointToWorldSpace(v3(cos(angle) * radius, 0, sin(angle) * radius))
        local scr_pt, on_screen = w2v(world_pt)
        points[i] = {scr_pt, on_screen}
    end
    for i = 1, circle_segments do
        local next_i = (i % circle_segments) + 1
        local p1 = points[i]
        local p2 = points[next_i]
        local line = circle_lines[i]
        if p1[2] and p2[2] then
            line.From = v2(p1[1].X, p1[1].Y)
            line.To = v2(p2[1].X, p2[1].Y)
            line.Color = color
            line.Visible = true
        else
            line.Visible = false
        end
    end
end

