local function get_key(bind_data)
    if not bind_data then return nil end
    local expected_key = type(bind_data) == "table" and bind_data.key or bind_data
    if type(expected_key) == "string" then
        local success, result = pcall(function() return Enum.KeyCode[expected_key] end)
        if success then return result end
    end
    return expected_key
end

create_connection(uis.InputBegan, function(input, gpe)
    if gpe then return end
    
    local menu_key = get_key(flags.menu_toggle_bind) or Enum.KeyCode.RightShift
    if input.KeyCode == menu_key or (menu_key == Enum.KeyCode.RightShift and input.KeyCode == Enum.KeyCode.Insert) then
        if library and library.gui then
            library.gui.Enabled = not library.gui.Enabled
        end
    end

    local ragebot_key = get_key(flags.ragebot_bind)
    if ragebot_key and input.KeyCode == ragebot_key then
        flags.ragebot = not flags.ragebot
        notify("ragebot: " .. (flags.ragebot and "enabled" or "disabled"), 1)
    end

    local target_key = get_key(flags.target_selection_target_bind)
    if target_key and input.KeyCode == target_key then
        if ragebot_target then 
            set_ragebot_target(nil, "target cleared")
        else
            local best = get_ragebot_target_func()
            set_ragebot_target(best, best and ("target set to " .. best[2].Name) or "no target found")
        end
    end
end)

