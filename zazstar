local function scan_shops()
    local shop_folder = ignored and (ignored:FindFirstChild("Shop") or ignored:WaitForChild("Shop", 5))
    if not shop_folder then return end
    for _, shop in pairs(shop_folder:GetChildren()) do
        local item = shop.Name:lower()
        local ammo, name, price = item:match("^(%d*)%s*%[(.-)%]%s*[%-%=]%s*%$(%d+)")
        if price then price = tonumber(price) end
        if name and price and price > 0 then
            local head = shop:FindFirstChild("Head") or shop:FindFirstChildWhichIsA("BasePart")
            local cd = shop:FindFirstChildOfClass("ClickDetector")
            if head and cd then
                shops[name] = {head.Position, price, cd, tonumber(ammo) or false, false, name, head}
            end
        end
    end
end
task.spawn(scan_shops)

local function buy_item(name, count)
    name = name:lower()
    local target_shop = nil
    for sname, data in pairs(shops) do
        if sname == name or sname:find(name, 1, true) or name:find(sname, 1, true) then
            target_shop = data
            break
        end
    end
    if not target_shop then
        scan_shops()
        for sname, data in pairs(shops) do
            if sname == name or sname:find(name, 1, true) or name:find(sname, 1, true) then
                target_shop = data
                break
            end
        end
    end
    if target_shop then
        notify("purchasing " .. target_shop[6], 1)
        local hrp = local_character and local_character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local old_cf = hrp.CFrame
            purchasing = target_shop
            local amt = count or 1
            for _ = 1, amt do
                hrp.CFrame = cfr(target_shop[1] - v3(0, 8.8, 0))
                task.wait(0.04)
                fireclickdetector(target_shop[3])
                task.wait(0.04)
            end
            hrp.CFrame = old_cf
            purchasing = nil
        end
    else
        notify("item not found in shop: " .. name, 3)
    end
end

