            fire_signal("on_player_tool_equipped", data, child)
        end
    end
    create_connection(character.ChildAdded, function(child)
        parts[child.Name] = child
        if child.ClassName == "Tool" then
            data[13] = child
            fire_signal("on_player_tool_equipped", data, child)
        end
    end)
    create_connection(character.ChildRemoved, function(child)
        parts[child.Name] = nil
        if child.ClassName == "Tool" then
            data[13] = nil
            fire_signal("on_player_tool_equipped", data, nil)
        end
    end)
    local old_hp = floor(humanoid.Health)
    create_connection(humanoid:GetPropertyChangedSignal("Health"), function()
        local hp = floor(humanoid.Health)
        data[9] = hp
        fire_signal("on_player_health_changed", data, hp, old_hp - hp)
        old_hp = hp
    end)
    create_connection(humanoid:GetPropertyChangedSignal("MaxHealth"), function()
        data[10] = floor(humanoid.MaxHealth)
    end)
    data[9] = old_hp
    data[10] = floor(humanoid.MaxHealth)
    data[11] = old_hp
    fire_signal("on_player_character_added", data, character)
    local body_fx = character:WaitForChild("BodyEffects", 9e9)
    local sdeath = body_fx:WaitForChild("SDeath", 9e9)
    local dead = body_fx:WaitForChild("Dead", 9e9)
    local armor = body_fx:WaitForChild("Armor", 9e9)
    local ko = body_fx:WaitForChild("K.O", 9e9)
