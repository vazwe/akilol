            local_guns[handle] = new_gun
        end
    end
end

local function on_local_child_removed(child)
    local_parts[child.Name] = nil
    if child.ClassName == "Tool" then
        fire_signal("on_local_tool_equipped", false, child)
        local handle = child:FindFirstChild("Handle")
        if handle then
            local old = local_guns[handle]
            if old then
                if old[4] then old[4]:Disconnect() end
                local_guns[handle] = nil
            end
        end
        local found = nil
        for k, v in pairs(local_guns) do found = k break end
        local_gun = found and local_gun or 350
        local_tool = found and found.Parent or nil
    end
end

