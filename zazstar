local function get_target_hitbox(target_data, preferred)
    if not target_data or not target_data[4] then return nil end
    local parts = target_data[4]
    local pref = type(preferred) == "table" and preferred[1] or preferred or "head"
    pref = tostring(pref):lower()
    if pref == "head" then
        return parts.Head or parts.HumanoidRootPart
    elseif pref == "root" or pref == "humanoidrootpart" then
        return parts.HumanoidRootPart or parts.UpperTorso or parts.Torso or parts.Head
    else
        return parts.UpperTorso or parts.Torso or parts.HumanoidRootPart or parts.Head
    end
end

local function apply_hrp_fix(hrp)
    local old = getrawmetatable(hrp)
    local old_index = old.__index
    local new_mt = {}
    new_mt.__index = newcclosure(function(self, idx)
        if not checkcaller() and self and idx == "CFrame" and (#anti_aim ~= 0 or purchasing) and not vehicle then
            return local_client_position
        end
        return old_index(self, idx)
    end)
    for k, v in old do if not new_mt[k] then new_mt[k] = v end end
    setrawmetatable(hrp, new_mt)
end

local function hook_humanoid(humanoid)
    local old = getrawmetatable(humanoid)
    local old_index = old.__index
    local old_newindex = old.__newindex
    local cached = {WalkSpeed = humanoid.WalkSpeed, JumpPower = humanoid.JumpPower}
    local new_mt = {}
    new_mt.__index = newcclosure(function(self, idx)
        if not checkcaller() and self and (idx == "WalkSpeed" or idx == "JumpPower") then
            return cached[idx]
        end
        return old_index(self, idx)
    end)
    new_mt.__newindex = newcclosure(function(self, idx, val)
        if not checkcaller() and self then
            if idx == "WalkSpeed" and flags.remove_slowdowns and val < 16 then
                cached[idx] = val
                if flags.remove_slowdowns then return end
            elseif idx == "JumpPower" then
                if flags.remove_jump_cooldown and val == 0 then cached[idx] = 0 return end
                if flags.jump_power and flags.jump_power_value then val = flags.jump_power_value end
            end
        end
        return old_newindex(self, idx, val)
    end)
    for k, v in old do if not new_mt[k] then new_mt[k] = v end end
    setrawmetatable(humanoid, new_mt)
end

